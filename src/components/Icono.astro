---
// Íconos de línea fina (trazo de 1,25 px), dibujados para el sitio. Sin librerías.
interface Props {
  nombre: 'whatsapp' | 'flecha' | 'diamante' | 'reloj' | 'frasco' | 'pin' | 'instagram' | 'tiktok' | 'buscar' | 'cerrar' | 'abajo';
  clase?: string;
}
const { nombre, clase } = Astro.props;
---

{
  nombre === 'whatsapp' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.21 8.21 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23a8.2 8.2 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.99-1.23-.73-.66-1.23-1.47-1.37-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48a.92.92 0 0 0-.67.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.57.12.16 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z"
      />
    </svg>
  ) : nombre === 'flecha' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25">
      <path d="M3 12h17M14 6l6 6-6 6" />
    </svg>
  ) : nombre === 'abajo' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25">
      <path d="M12 3v17M6 14l6 6 6-6" />
    </svg>
  ) : nombre === 'diamante' ? (
    <svg class={clase} viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
      <path d="M8 18 15 9h18l7 9-16 22L8 18Z" />
      <path d="M8 18h32M15 9l4 9 5-9 5 9 4-9M19 18l5 22 5-22" />
    </svg>
  ) : nombre === 'reloj' ? (
    <svg class={clase} viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round">
      <circle cx="24" cy="24" r="16" />
      <circle cx="24" cy="24" r="19.5" stroke-dasharray="1 3.1" />
      <path d="M24 14v10l6.5 4" />
    </svg>
  ) : nombre === 'frasco' ? (
    <svg class={clase} viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
      <path d="M24 3.5 27.5 8 24 12.5 20.5 8 24 3.5Z" />
      <path d="M19.5 12.5h9v3.5h-9zM20.5 16v2.2c-6 2.4-10 7.6-10 13.3 0 4.6 2.4 8.4 6 10.5h15c3.6-2.1 6-5.9 6-10.5 0-5.7-4-10.9-10-13.3V16" />
      <circle cx="24" cy="30.5" r="4.2" />
      <path d="M16.5 42h15" />
    </svg>
  ) : nombre === 'pin' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25">
      <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" />
      <circle cx="12" cy="9.8" r="2.3" />
    </svg>
  ) : nombre === 'instagram' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25">
      <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
    </svg>
  ) : nombre === 'tiktok' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
      <path d="M14 3.5v11.2a3.8 3.8 0 1 1-3.8-3.8M14 3.5c.4 2.6 2.4 4.6 5 4.9" />
    </svg>
  ) : nombre === 'buscar' ? (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25">
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="m15.3 15.3 5.2 5.2" />
    </svg>
  ) : (
    <svg class={clase} viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.25">
      <path d="M5 5l14 14M19 5 5 19" />
    </svg>
  )
}
